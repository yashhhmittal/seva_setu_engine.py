# --- Command Line Interface ---
def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')

def print_menu():
    print(f"\n{Colors.BOLD}{Colors.CYAN}--- SEVA SETU OFFLINE SYSTEM ---{Colors.ENDC}")
    print("1. Register New Student")
    print("2. Input Classroom Assessment Scores")
    print("3. Generate Bilingual Printed Kit")
    print("4. View All Registered Students")
    print("5. Exit")
    print(f"{Colors.CYAN}--------------------------------{Colors.ENDC}")

def main():
    init_db()
    platform = SevaSetuPlatform()
    seed_initial_data(platform)
    
    clear_screen()
    print(f"{Colors.BOLD}{Colors.GREEN}System Initialized. Ready for offline classroom deployment.{Colors.ENDC}")

    while True:
        print_menu()
        choice = input(f"{Colors.BOLD}Select an option (1-5): {Colors.ENDC}")

        if choice == '1':
            print(f"\n{Colors.UNDERLINE}Student Registration{Colors.ENDC}")
            name = input("Full Name: ")
            age = int(input("Age: "))
            grade = input("Grade/Class: ")
            lang = input("Primary Language (English/Hindi) [Default: Hindi]: ") or "Hindi"
            
            s_id = platform.register_student(name, age, grade, lang)
            print(f"{Colors.GREEN}Success! Student registered with ID: {s_id}{Colors.ENDC}")

        elif choice == '2':
            print(f"\n{Colors.UNDERLINE}Record Assessment Scores (1-10){Colors.ENDC}")
            s_id = int(input("Student ID: "))
            
            # Verify student exists
            if not platform.get_student_profile(s_id):
                print(f"{Colors.FAIL}Error: No student found with ID {s_id}.{Colors.ENDC}")
                continue

            try:
                scores = {
                    'analytical': int(input("Analytical Score: ")),
                    'creative': int(input("Creative Score: ")),
                    'communication': int(input("Communication Score: ")),
                    'technical': int(input("Technical Score: "))
                }
                platform.record_assessment(s_id, scores)
                print(f"{Colors.GREEN}Scores saved successfully!{Colors.ENDC}")
            except ValueError:
                print(f"{Colors.FAIL}Error: Please enter valid numbers.{Colors.ENDC}")

        elif choice == '3':
            print(f"\n{Colors.UNDERLINE}Generate Classroom Kit{Colors.ENDC}")
            try:
                s_id = int(input("Enter Student ID to generate report: "))
                platform.print_bilingual_kit(s_id)
            except ValueError:
                print(f"{Colors.FAIL}Error: Invalid ID.{Colors.ENDC}")

        elif choice == '4':
            print(f"\n{Colors.UNDERLINE}Registered Students{Colors.ENDC}")
            platform.cursor.execute("SELECT id, full_name, current_grade FROM students")
            students = platform.cursor.fetchall()
            if not students:
                print("No students registered yet.")
            else:
                for s in students:
                    print(f"ID: {s['id']} | Name: {s['full_name']} | Grade: {s['current_grade']}")

        elif choice == '5':
            print(f"\n{Colors.BLUE}Shutting down offline engine. Goodbye!{Colors.ENDC}")
            sys.exit(0)
            
        else:
            print(f"{Colors.FAIL}Invalid option. Please try again.{Colors.ENDC}")

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print(f"\n{Colors.WARNING}Process interrupted by user. Exiting safely...{Colors.ENDC}")
        sys.exit(0)
