    """Populates the database with foundational career data if empty."""
    platform.cursor.execute("SELECT COUNT(*) FROM career_paths")
    if platform.cursor.fetchone()[0] == 0:
        print(f"{Colors.BLUE}Seeding offline database with bilingual career data...{Colors.ENDC}")
        
        pathways = [
            {
                "en": "Software Development", "hi": "सॉफ्टवेयर विकास", "cat": "STEM", 
                "desc_en": "Building applications and writing code for computers.",
                "desc_hi": "कंप्यूटर के लिए एप्लिकेशन बनाना और कोड लिखना।",
                "apt": "Technical"
            },
            {
                "en": "Data Analysis", "hi": "डेटा विश्लेषण", "cat": "STEM", 
                "desc_en": "Interpreting data to help businesses make decisions.",
                "desc_hi": "व्यवसायों को निर्णय लेने में मदद करने के लिए डेटा की व्याख्या करना।",
                "apt": "Analytical"
            },
            {
                "en": "Graphic Design", "hi": "ग्राफिक डिजाइन", "cat": "Arts", 
                "desc_en": "Creating visual content to communicate messages.",
                "desc_hi": "संदेश संप्रेषित करने के लिए दृश्य सामग्री बनाना।",
                "apt": "Creative"
            },
            {
                "en": "Public Relations", "hi": "जनसंपर्क", "cat": "Humanities", 
                "desc_en": "Managing the spread of information between an organization and the public.",
                "desc_hi": "किसी संगठन और जनता के बीच सूचना के प्रसार का प्रबंधन करना।",
                "apt": "Communication"
            },
            {
                "en": "Financial Accounting", "hi": "वित्तीय लेखांकन", "cat": "Commerce", 
                "desc_en": "Keeping and interpreting financial records.",
                "desc_hi": "वित्तीय रिकॉर्ड रखना और उनकी व्याख्या करना।",
