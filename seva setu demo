#!/usr/bin/env python3
"""
Seva Setu / Disha-Setu Core Engine
----------------------------------
An offline-first, bilingual (English/Hindi) career guidance platform backend.
Designed to assess student aptitudes in low-connectivity environments, match 
them with viable career pathways, and generate offline-ready printed kits.

Version: 1.0.0
Architecture: SQLite Local Database + Interactive CLI
"""

import sqlite3
import json
import os
import sys
from datetime import datetime
from typing import List, Dict, Optional

# --- ANSI Color Codes for Attractive Terminal UI ---
class Colors:
    HEADER = '\033[95m'
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    GREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'

# --- Database Initialization & Schema ---
DB_NAME = "seva_setu_offline.db"

def init_db():
    """Initializes the offline SQLite database for classroom deployments."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()

    # Students Table
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS students (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            full_name TEXT NOT NULL,
            age INTEGER,
            current_grade TEXT,
            primary_language TEXT DEFAULT 'Hindi',
            registration_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')

    # Career Pathways Table (Bilingual)
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS career_paths (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            title_en TEXT NOT NULL,
            title_hi TEXT NOT NULL,
            category TEXT NOT NULL,
            description_en TEXT,
            description_hi TEXT,
            required_aptitude TEXT
        )
    ''')

    # Assessments Table
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS assessments (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            student_id INTEGER,
            analytical_score INTEGER,
            creative_score INTEGER,
            communication_score INTEGER,
            technical_score INTEGER,
            FOREIGN KEY (student_id) REFERENCES students(id)
        )
    ''')

    conn.commit()
    conn.close()

# --- Core Platform Engine ---
class SevaSetuPlatform:
    def __init__(self):
        self.conn = sqlite3.connect(DB_NAME)
        self.conn.row_factory = sqlite3.Row
        self.cursor = self.conn.cursor()

    def register_student(self, name: str, age: int, grade: str, lang: str = "Hindi") -> int:
        """Registers a student into the offline system."""
        self.cursor.execute(
            "INSERT INTO students (full_name, age, current_grade, primary_language) VALUES (?, ?, ?, ?)",
            (name, age, grade, lang)
        )
        self.conn.commit()
        return self.cursor.lastrowid

    def add_career_pathway(self, title_en: str, title_hi: str, category: str, desc_en: str, desc_hi: str, req_apt: str):
        """Adds a bilingual career pathway to the repository."""
        self.cursor.execute(
            """INSERT INTO career_paths 
               (title_en, title_hi, category, description_en, description_hi, required_aptitude) 
               VALUES (?, ?, ?, ?, ?, ?)""",
            (title_en, title_hi, category, desc_en, desc_hi, req_apt)
        )
        self.conn.commit()

    def record_assessment(self, student_id: int, scores: Dict[str, int]):
        """Saves a student's aptitude scores from the offline printed test."""
        self.cursor.execute(
            """INSERT INTO assessments 
               (student_id, analytical_score, creative_score, communication_score, technical_score) 
               VALUES (?, ?, ?, ?, ?)""",
            (student_id, scores['analytical'], scores['creative'], scores['communication'], scores['technical'])
        )
        self.conn.commit()

    def get_student_profile(self, student_id: int) -> Optional[sqlite3.Row]:
        self.cursor.execute("SELECT * FROM students WHERE id = ?", (student_id,))
        return self.cursor.fetchone()

    def get_assessment(self, student_id: int) -> Optional[sqlite3.Row]:
        self.cursor.execute("SELECT * FROM assessments WHERE student_id = ? ORDER BY id DESC LIMIT 1", (student_id,))
        return self.cursor.fetchone()

    def generate_career_match(self, student_id: int) -> List[sqlite3.Row]:
        """Matches a student to a career based on their highest aptitude score."""
        assessment = self.get_assessment(student_id)
        if not assessment:
            return []

        scores = {
            'Analytical': assessment['analytical_score'],
            'Creative': assessment['creative_score'],
            'Communication': assessment['communication_score'],
            'Technical': assessment['technical_score']
        }
        
        # Find the dominant aptitude
        dominant_trait = max(scores, key=scores.get)
        
        self.cursor.execute("SELECT * FROM career_paths WHERE required_aptitude = ?", (dominant_trait,))
        return self.cursor.fetchall()

    def print_bilingual_kit(self, student_id: int):
        """Generates a text-based layout for the physical printed classroom kit."""
        student = self.get_student_profile(student_id)
        matches = self.generate_career_match(student_id)

        if not student:
            print(f"{Colors.FAIL}Error: Student not found.{Colors.ENDC}")
            return

        print(f"\n{Colors.HEADER}======================================================{Colors.ENDC}")
        print(f"{Colors.BOLD}   DISHA-SETU / SEVA SETU - STUDENT CAREER REPORT   {Colors.ENDC}")
        print(f"{Colors.HEADER}======================================================{Colors.ENDC}")
        print(f"Student Name / छात्र का नाम: {student['full_name']}")
        print(f"Grade / कक्षा: {student['current_grade']}")
        print(f"Date / दिनांक: {datetime.now().strftime('%Y-%m-%d')}")
        print(f"{Colors.HEADER}------------------------------------------------------{Colors.ENDC}")
        
        if not matches:
            print(f"{Colors.WARNING}No assessment data found. Please run assessment first.{Colors.ENDC}")
            print(f"{Colors.WARNING}कोई मूल्यांकन डेटा नहीं मिला। कृपया पहले मूल्यांकन करें।{Colors.ENDC}")
            return

        print(f"{Colors.GREEN}Recommended Pathways | अनुशंसित मार्ग:{Colors.ENDC}\n")
        
        for idx, match in enumerate(matches, 1):
            print(f"{Colors.CYAN}{idx}. {match['title_en']} / {match['title_hi']}{Colors.ENDC}")
            print(f"   Category: {match['category']}")
            print(f"   About: {match['description_en']}")
            print(f"   विवरण: {match['description_hi']}\n")
        
        print(f"{Colors.HEADER}======================================================{Colors.ENDC}\n")


# --- Data Seeding Module ---
